# Copy to hub.env on the Hub and chmod 600 it. Do not commit the copy.
FRIDAY_OWNER_ID=owner
FRIDAY_OWNER_TOKEN=REPLACE_WITH_A_RANDOM_32_BYTE_BASE64URL_TOKEN
# Tailnet HTTPS browser Origin. RP ID is needed only for optional Passkey use.
# FRIDAY_PUBLIC_ORIGIN=https://friday.example.com
# FRIDAY_WEBAUTHN_RP_ID=friday.example.com
# Single Owner Web password. Store only in this root-owned 0600 file.
# Browser Basic Auth password for the single Owner account.
# FRIDAY_WEB_PASSWORD=replace-with-a-long-unique-password
# Fixed-origin DuckDuckGo HTML search for Pi; no API key is sent.
# FRIDAY_WEB_SEARCH_ENABLE=0
# Optional M3 Procedure signature verification key (public Ed25519 PEM).
# Leave unset to keep Procedure/Skill routes disabled. The deployed copy may
# contain private provider keys and therefore must stay root-owned 0600; never
# put the populated copy, channel credentials, or MCP secrets in Git.
# FRIDAY_PROCEDURE_OWNER_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Optional independent M3 Skill signature verification key.  A Skill is inert
# until its exact digest has sandbox replay evidence and Owner enables it.
# FRIDAY_SKILL_OWNER_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Optional M2 voice provider. All four values are required together; otherwise
# the media upload endpoint remains available but STT/TTS returns VOICE_DISABLED.
# FRIDAY_VOICE_BASE_URL=https://voice-provider.example/v1/
# FRIDAY_STT_MODEL=whisper-1
# FRIDAY_TTS_MODEL=tts-1
# FRIDAY_VOICE_API_KEY=REPLACE_WITH_PRIVATE_KEY
# Optional M3 Broker client. These only connect Fridayd to its private Unix
# socket; its outbound-origin whitelist stays in mcp-broker.env.
# FRIDAY_MCP_BROKER_ENABLE=1
# FRIDAY_MCP_BROKER_SOCKET=/run/friday-mcp-broker/broker.sock
# Optional M5 Conversation Orchestrator. All values are required together and
# the API remains AGENT_DISABLED otherwise. The lockfile pins the audited Pi
# 0.84.1 package and the Hub image exposes its executable at the path below.
# FRIDAY_CONVERSATION_ENABLE=1
# FRIDAY_PI_NODE_BIN=/usr/local/bin/node
# FRIDAY_PI_WORKER_SCRIPT=/app/apps/pi-worker/dist/index.js
# FRIDAY_PI_BIN=/app/node_modules/.bin/pi
# FRIDAY_PI_BASE_URL=https://private-model-provider.example/v1/
# FRIDAY_PI_MODEL=private-model-id
# FRIDAY_PI_API_KEY=REPLACE_WITH_PRIVATE_KEY
# FRIDAY_PI_WORKER_REQUEST_TIMEOUT_MS=10000
# FRIDAY_PI_TURN_TIMEOUT_MS=180000
# Optional remote Runner model credential proxy. OpenAI-compatible settings
# enable Codex and Pi; Anthropic-compatible settings enable Claude Code. The
# Hub overwrites every requested model and never returns these long-lived keys.
# FRIDAY_RUNNER_OPENAI_BASE_URL=https://private-model-provider.example/v1/
# FRIDAY_RUNNER_OPENAI_API_KEY=REPLACE_WITH_PRIVATE_KEY
# FRIDAY_RUNNER_CODEX_MODEL=fixed-codex-model-id
# FRIDAY_RUNNER_PI_MODEL=fixed-pi-model-id
# FRIDAY_RUNNER_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
# FRIDAY_RUNNER_ANTHROPIC_API_KEY=REPLACE_WITH_PRIVATE_KEY
# FRIDAY_RUNNER_CLAUDE_MODEL=fixed-claude-model-id
# FRIDAY_RUNNER_MODEL_TOKEN_TTL_SECONDS=300
# FRIDAY_RUNNER_MODEL_REQUEST_TIMEOUT_MS=900000
# FRIDAY_RUNNER_MODEL_MAX_REQUEST_BYTES=16777216
# Optional loopback control plane for the isolated iLink Channel Gateway.
# Both values are required together and the 32-byte control token must match.
# FRIDAY_CHANNEL_GATEWAY_CONTROL_URL=http://127.0.0.1:4311/
# FRIDAY_CHANNEL_GATEWAY_CONTROL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_BASE64URL_TOKEN
# Optional: allow the paired private channel to confirm R1/R2 actions by
# replying "确认". R3 actions still require the authenticated Web session.
# Keep disabled unless the channel is private and bound to the Owner.
# FRIDAY_CHANNEL_APPROVAL_ENABLE=0
# Only this registered source Workspace may produce Friday self-improvement patches.
FRIDAY_SELF_WORKSPACE_ID=friday-agent
