# Copy to .env on the Hub. Read UID/GID from the dedicated service account;
# these values are examples, not portable defaults.
FRIDAY_UID=1000
FRIDAY_GID=1000
FRIDAY_STATE_DIR=/var/lib/friday-hub/state
FRIDAY_GATEWAY_STATE_DIR=/var/lib/friday-channel-gateway
# Optional M3 Broker Origin allow-list. This Compose-only variable is passed
# to the Broker sidecar, not to the Hub container. Leave empty unless using
# `docker compose --profile mcp`.
# FRIDAY_MCP_BROKER_ALLOWED_ORIGINS=https://search.example.invalid
