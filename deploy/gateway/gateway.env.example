# Keep this root-owned 0600 file outside Git. The container talks to the Hub
# over loopback; external Web and Runner traffic uses the configured HTTPS URL.
FRIDAY_GATEWAY_HUB_URL=http://127.0.0.1:4310
# FRIDAY_TELEGRAM_INGEST_TOKEN=generated-at-Hub-then-stored-here
# FRIDAY_WECHAT_ILINK_INGEST_TOKEN=generated-at-Hub-then-stored-here
# Official iLink QR pairing, long polling, and replies are opt-in. The Bot
# Token is obtained by QR pairing and then stored mode 0600 below STATE_DIR.
# FRIDAY_WECHAT_ILINK_BASE_URL=https://ilinkai.weixin.qq.com/
# Compose sets FRIDAY_GATEWAY_STATE_DIR=/state.
# FRIDAY_WECHAT_ILINK_CHANNEL_VERSION=0.1.1
# FRIDAY_WECHAT_ILINK_APP_ID=bot
# The same control token is configured in Hub and Gateway private env files.
# FRIDAY_GATEWAY_CONTROL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_BASE64URL_TOKEN
FRIDAY_GATEWAY_PORT=4311
