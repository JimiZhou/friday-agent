# Mode 0640 root:root is sufficient: systemd reads this file before dropping
# to the Runner account. It intentionally contains no enrollment or model token.
FRIDAY_HUB_URL=https://friday-hub.example.ts.net
FRIDAY_RUNNER_NAME=managed-node-01
FRIDAY_RUNNER_STATE_DIR=/var/lib/friday-runner
FRIDAY_WORKSPACE_ROOT=/srv/friday-workspaces
FRIDAY_HEARTBEAT_INTERVAL_MS=15000
FRIDAY_REQUEST_TIMEOUT_MS=10000
# The Runner only talks to this root-managed local Unix socket; it never gets Docker access.
FRIDAY_SANDBOX_SOCKET=/run/friday-sandboxd/sandboxd.sock
