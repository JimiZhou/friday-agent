# Root-owned, mode 0600. Values with a sha256 image digest are deployment metadata, not credentials.
FRIDAY_SANDBOX_SOCKET=/run/friday-sandboxd/sandboxd.sock
FRIDAY_SANDBOX_RUNNER_STATE_DIR=/var/lib/friday-runner
FRIDAY_SANDBOX_HUB_PUBLIC_KEY_FILE=/etc/friday-sandboxd/hub-ed25519.pub
FRIDAY_SANDBOX_HUB_URL=https://friday-hub.example-tailnet.ts.net
FRIDAY_SANDBOX_MODEL_RELAY_DIR=/run/friday-sandboxd/model-relays
FRIDAY_SANDBOX_MODEL_MAX_REQUEST_BYTES=16777216
FRIDAY_SANDBOX_RUNNER_UID=1000
FRIDAY_SANDBOX_RUNNER_GID=1000
# Build and inspect this image independently. The daemon checks this exact image id on every request.
FRIDAY_SANDBOX_AGENT_IMAGE=friday-agent:0.1.0
FRIDAY_SANDBOX_AGENT_IMAGE_ID=sha256:REPLACE_WITH_64_HEX_IMAGE_ID
# One fixed Agent image contains exact Codex/Pi/Claude versions. The short-lived
# Hub token stays in sandboxd memory and is never passed into this container.
# Configure each adapter only after its image id and end-to-end fixture pass.
# FRIDAY_SANDBOX_CODEX_IMAGE=friday-agent:RELEASE_ID
# FRIDAY_SANDBOX_CODEX_IMAGE_ID=sha256:REPLACE_WITH_64_HEX_IMAGE_ID
# FRIDAY_SANDBOX_PI_IMAGE=friday-agent:RELEASE_ID
# FRIDAY_SANDBOX_PI_IMAGE_ID=sha256:REPLACE_WITH_64_HEX_IMAGE_ID
# FRIDAY_SANDBOX_CLAUDE_IMAGE=friday-agent:RELEASE_ID
# FRIDAY_SANDBOX_CLAUDE_IMAGE_ID=sha256:REPLACE_WITH_64_HEX_IMAGE_ID
