{
  "name": "@friday/runner",
  "version": "0.2.0",
  "private": true,
  "description": "Outbound-only Friday runner skeleton",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "bin": {
    "friday-runner": "./dist/index.js"
  },
  "files": [
    "dist"
